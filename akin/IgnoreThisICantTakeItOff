public class Fibonacci {
    public static void main(String[] args){
        int i = args[0];
        int a = 1;
        int b = 1;
        int c = a + b;

        while (i > 2) {
            System.out.println(a);
            System.out.println(b);
            System.out.println(c);
                
            a = b;
            b = c;
            c = a + b;
                
            i = i - 1;
        }
    }
}
